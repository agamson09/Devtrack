# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=devtrack
DB_CONNECTION_LIMIT=20

# MySQL credentials for backup/restore operations (used by database.js)
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Remote Agent
REMOTE_AGENT_PASSWORD=your_remote_agent_password_here

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com

# IT Vault Encryption Key
IT_VAULT_KEY=your_vault_encryption_key_here

# Optional self-hosted TURN server (for remote desktop behind strict NAT)
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USER=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Backup storage directory (default: /var/backups/mysql on Linux, %TEMP%\devtrack-backups on Windows)
# BACKUP_DIR=/var/backups/mysql

# SSO / OAuth login (optional — providers with credentials set appear on the login page)
# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID
# Callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers -> OAuth App
# Callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generic OIDC (Azure AD / Entra ID, Keycloak, Authentik, ...)
# Callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/oauth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile
